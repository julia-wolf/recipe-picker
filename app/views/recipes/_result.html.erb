<article>
  <%= link_to recipe_path(result.recipe, ingredients: @ingredients), class: "recipe-card" do %>
    <%= recipe_photo_tag(result.recipe) %>
    <div class="recipe-card-copy">
      <h3><%= result.recipe.title %></h3>
      <% if result.missing.any? %>
        <p><%= t(".extra_ingredients", list: result.missing.join(", ")) %></p>
      <% end %>
      <% if result.staples.any? %>
        <p><%= t(".pantry_staples", list: result.staples.join(", ")) %></p>
      <% end %>
      <p><%= recipe_time(result.recipe) %></p>
      <span class="recipe-open"><%= t(".see_recipe") %></span>
    </div>
  <% end %>
</article>
