<h1><%= t("recipes.title") %></h1>
<p><%= t(".lead") %></p>

<%= form_with url: recipes_path, method: :get do %>
  <p>
    <%= label_tag :ingredients, t(".ingredients_label") %><br>
    <%= text_area_tag :ingredients, @ingredients, rows: 3, placeholder: t(".ingredients_placeholder") %>
  </p>
  <p><%= submit_tag t(".submit") %></p>
<% end %>

<% unless @ingredients.blank? || @search.staples_only? %>
  <% if @search.empty? && @search.needs_more? %>
    <p><%= t(".empty.too_far", count: @search.pantry_terms.size) %></p>
  <% elsif @search.empty? %>
    <p><%= t(".empty.unknown", count: @search.pantry_terms.size) %></p>
  <% else %>
    <% if @search.cook_now.any? %>
      <section>
        <h2><%= t(".cook_now") %></h2>
        <%= render partial: "result", collection: @search.cook_now, as: :result %>
      </section>
    <% end %>

    <% if @search.almost.any? %>
      <section>
        <h2><%= t(".almost") %></h2>
        <%= render partial: "result", collection: @search.almost, as: :result %>
      </section>
    <% end %>
  <% end %>
<% end %>
