<h1>Recipe picker</h1>

<%= form_with url: recipes_path, method: :get do %>
  <p>
    <%= label_tag :q, "Ingredients you have" %><br>
    <%= text_area_tag :q, @query, rows: 3, cols: 40 %>
  </p>
  <p><%= submit_tag "Find recipes" %></p>
<% end %>

<% if @query.blank? %>
  <p>Enter pantry ingredients, separated by commas or new lines.</p>
<% elsif @staples_only %>
  <p>Salt, pepper, water, and black pepper are assumed. Add another ingredient to find recipes.</p>
<% elsif @results.empty? %>
  <p>No recipes match those ingredients.</p>
<% else %>
  <% @results.each do |result| %>
    <article>
      <% if result.recipe.image_url.present? %>
        <p><%= image_tag result.recipe.image_url, alt: result.recipe.title %></p>
      <% end %>
      <h2><%= link_to result.recipe.title, recipe_path(result.recipe, q: @query) %></h2>
      <p><%= result.match_signal %></p>
      <p><%= recipe_time(result.recipe) %></p>
    </article>
  <% end %>

  <nav class="pagination">
    <% if @results.page > 1 %>
      <%= link_to "Previous", recipes_path(q: @query, page: @results.page - 1) %>
    <% end %>
    <% if @results.has_next? %>
      <%= link_to "Next", recipes_path(q: @query, page: @results.page + 1) %>
    <% end %>
  </nav>
<% end %>
