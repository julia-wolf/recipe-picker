<h1>Cook from your pantry</h1>
<p>Tonight’s recipes, ranked by what you already have.</p>

<%= form_with url: recipes_path, method: :get do %>
  <p>
    <%= label_tag :ingredients, "What you have at home" %><br>
    <%= text_area_tag :ingredients, @ingredients, rows: 3, placeholder: "chicken, onion, garlic" %>
  </p>
  <p><%= submit_tag "Find recipes" %></p>
<% end %>

<% if @ingredients.blank? %>
  <p>List ingredients, comma or line separated. Salt, pepper, and water are assumed.</p>
<% elsif @staples_only %>
  <p>Salt, pepper, and water are already assumed. Add a food — chicken, eggs, rice.</p>
<% elsif @results.empty? %>
  <p>No recipes match that pantry. Try a main ingredient like chicken or onion.</p>
<% else %>
  <% if @cook_now.any? %>
    <section>
      <h2>Cook now</h2>
      <p>You have everything.</p>
      <%= render partial: "result", collection: @cook_now, as: :result %>
    </section>
  <% end %>

  <% if @almost.any? %>
    <section>
      <h2>Almost there</h2>
      <p>Missing 1 or 2 ingredients.</p>
      <%= render partial: "result", collection: @almost, as: :result %>
    </section>
  <% end %>
<% end %>
