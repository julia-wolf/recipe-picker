<h1>What’s for dinner?</h1>
<p>Tonight’s dinner, from what you already have.</p>

<%= form_with url: recipes_path, method: :get do %>
  <p>
    <%= label_tag :ingredients, "Type the ingredients you have:" %><br>
    <%= text_area_tag :ingredients, @ingredients, rows: 3, placeholder: "eggs, onion, tomato" %>
  </p>
  <p><%= submit_tag "Find recipes" %></p>
<% end %>

<% unless @ingredients.blank? || @staples_only %>
  <% if @results.empty? && @too_far %>
    <% if pantry_entry_count(@ingredients) > 1 %>
      <p>These ingredients are in recipes, but each still needs more than three extra ingredients. Add another ingredient you already have.</p>
    <% else %>
      <p>That ingredient is in recipes, but each still needs more than three extra ingredients. Add another ingredient you already have.</p>
    <% end %>
  <% elsif @results.empty? %>
    <% if pantry_entry_count(@ingredients) > 1 %>
      <p>These ingredients do not appear in any recipe. Add another ingredient you already have.</p>
    <% else %>
      <p>That ingredient does not appear in any recipe. Add another ingredient you already have.</p>
    <% end %>
  <% else %>
    <% if @cook_now.any? %>
      <section>
        <h2>You have everything to cook:</h2>
        <%= render partial: "result", collection: @cook_now, as: :result %>
      </section>
    <% end %>

    <% if @almost.any? %>
      <section>
        <h2>You still need 1 to 3 extra ingredients to cook:</h2>
        <%= render partial: "result", collection: @almost, as: :result %>
      </section>
    <% end %>
  <% end %>
<% end %>
