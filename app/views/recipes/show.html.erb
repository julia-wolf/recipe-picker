<p><%= link_to "Back to recipes", recipes_path(ingredients: @ingredients) %></p>

<h1><%= @recipe.title %></h1>

<p><%= recipe_photo_tag(@recipe) %></p>

<p><%= recipe_time(@recipe, detail: true) %></p>


<h2>Ingredients</h2>
<ul>
  <% @recipe.recipe_ingredients.each do |line| %>
    <li><%= line.display_text %></li>
  <% end %>
</ul>
