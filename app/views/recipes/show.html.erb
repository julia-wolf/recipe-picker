<p>
  <%= link_to "Back", recipes_path(ingredients: @ingredients) %>
</p>

<h1><%= @recipe.title %></h1>

<p><%= recipe_photo_tag(@recipe) %></p>

<% recipe_time_lines(@recipe).each do |line| %>
  <p><%= line %></p>
<% end %>

<% if @explanation %>
  <% if @explanation.have.any? %>
    <h2>In your pantry:</h2>
    <ul>
      <% @explanation.have.each do |line| %>
        <li><%= line %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @explanation.missing.any? %>
    <h2>Extra ingredients:</h2>
    <ul>
      <% @explanation.missing.each do |line| %>
        <li><%= line %></li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <h2>Extra ingredients:</h2>
  <ul>
    <% @recipe.recipe_ingredients.each do |line| %>
      <li><%= line.display_text %></li>
    <% end %>
  </ul>
<% end %>
